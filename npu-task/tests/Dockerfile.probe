ARG HAILO_IMAGE=ghcr.io/snu-rtos/osh-compile:latest
FROM ${HAILO_IMAGE} AS build
WORKDIR /src
COPY inference/src/npu_probe.cpp camera/src/gpu_compositor_probe.cpp ./
RUN g++ -std=c++17 -O2 -pthread npu_probe.cpp -lhailort -o /npu_probe && \
    g++ -std=c++17 -O2 -pthread gpu_compositor_probe.cpp \
      $(pkg-config --cflags --libs gstreamer-1.0 gstreamer-app-1.0) -o /gpu_compositor_probe
FROM ${HAILO_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends gstreamer1.0-gl && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /npu_probe /app/npu_probe
COPY --from=build /gpu_compositor_probe /app/gpu_compositor_probe
COPY yolov10s.hef /models/yolov10s.hef
ENTRYPOINT ["/app/npu_probe"]

+package cdi
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func TestAtomicPublication(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "hailo.json")
+	data := []byte(`{"devices":[{"name":"hailo0"}]}`)
+	if err := atomicWrite(file, data); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			if err := atomicWrite(file, data); err != nil {
+				t.Error(err)
+				return
+			}
+		}
+	}()
+	for i := 0; i < 1000; i++ {
+		b, err := os.ReadFile(file)
+		if err != nil || !json.Valid(b) {
+			t.Errorf("partial CDI: %s %v", b, err)
+			break
+		}
+	}
+	wg.Wait()
+}
+
+func TestPrivateSysfsAndNoSharedCleanup(t *testing.T) {
+	dir := t.TempDir()
+	if err := GenerateCDI(nil, dir); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "hailo.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var spec CDISpec
+	if err = json.Unmarshal(data, &spec); err != nil {
+		t.Fatal(err)
+	}
+	edits := spec.ContainerEdits
+	if len(edits.Hooks) != 0 || len(edits.Mounts) != 1 || edits.Mounts[0].Type != "tmpfs" {
+		t.Fatal("sysfs must be private without shared cleanup")
+	}
+}

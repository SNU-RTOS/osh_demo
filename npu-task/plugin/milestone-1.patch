@@ -0,0 +1,28 @@
+package plugin
+
+import (
+	"context"
+	pluginapi "k8s.io/kubelet/pkg/apis/deviceplugin/v1beta1"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAllocationValidation(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "hailo.json"), []byte(`{"devices":[{"name":"hailo0"}]}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	p := &HailoDevicePlugin{CdiDir: dir}
+	for _, ids := range [][]string{{"missing"}, {"hailo0", "hailo0"}, {}} {
+		if _, err := p.Allocate(context.Background(), &pluginapi.AllocateRequest{ContainerRequests: []*pluginapi.ContainerAllocateRequest{{DevicesIDs: ids}}}); err == nil {
+			t.Fatalf("accepted %v", ids)
+		}
+	}
+	req := &pluginapi.AllocateRequest{ContainerRequests: []*pluginapi.ContainerAllocateRequest{{DevicesIDs: []string{"hailo0"}}}}
+	for i := 0; i < 2; i++ {
+		if _, err := p.Allocate(context.Background(), req); err != nil {
+			t.Fatalf("idempotent allocation: %v", err)
+		}
+	}
+}

+
+// Publish a complete CDI snapshot in a single rename. Readers never see partial JSON.
+func atomicWrite(name string, data []byte) error {
+	f, err := os.CreateTemp(filepath.Dir(name), ".hailo-*.tmp")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	defer f.Close()
+	if err = f.Chmod(0644); err != nil {
+		return err
+	}
+	if _, err = f.Write(data); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(f.Name(), name)
+}
